@page "/"
@page "/mails"
@implements IDisposable
@inject IDbContextFactory<OrderMailDbContext> DbFactory
@inject MailProcessor Processor
@inject ReviewService Review
@inject NavigationManager Nav
@inject IToastService Toast

<PageTitle>受信メール</PageTitle>

<div class="page-head">
    <h2>受信メール</h2>
    <span class="spacer"></span>
    @if (Processor.IsRunning)
    {
        <FluentProgressRing Width="18px" />
        <span class="sub">@Processor.Progress</span>
    }
    else if (Processor.LastRun is { } run)
    {
        <span class="sub">
            前回 @StatusDisplay.Local(run.FinishedAtUtc)：取り込み @run.Imported 件 / 解析 @run.Analyzed 件@(run.Failed > 0 ? $" / 失敗 {run.Failed} 件" : "")
        </span>
    }
    <FluentButton Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size20.ArrowSync())" Disabled="Processor.IsRunning" OnClick="RunAsync">
        取り込み・解析
    </FluentButton>
</div>

<div class="filters">
    @foreach (var (key, label) in Filters)
    {
        <FluentButton Appearance="@(_filter == key ? Appearance.Accent : Appearance.Outline)" OnClick="@(() => _filter = key)">
            @label（@Count(key)）
        </FluentButton>
    }
    <FluentSearch Placeholder="キーワードで検索" Title="件名・差出人・本文と、発注の会社名・品名から探します。空白で区切るとすべてを含むメールに絞ります。"
                  Immediate="true" ImmediateDelay="300" Class="mail-search"
                  @bind-Value="_query" @bind-Value:after="SearchAsync" />
</div>

<div class="panel">
    @if (_rows.Count == 0)
    {
        <p class="sub">メールがありません。「取り込み・解析」を押すと、設定したメールフォルダから取り込みます。</p>
    }
    else if (_matches is { Count: 0 })
    {
        <p class="sub">「@_query」に一致するメールはありません。</p>
    }
    else
    {
        <div class="selection-bar">
            @if (_reanalyzeCts is not null)
            {
                <FluentButton Appearance="Appearance.Outline" IconStart="@(new Icons.Regular.Size16.Stop())" OnClick="CancelReanalyze">中止（解析中のメールの後で止めます）</FluentButton>
            }
            else
            {
                <FluentCheckbox Class="select-all" Label="すべて選択" Title="表示中のメールをすべて選択" Value="@AllVisibleSelected" ValueChanged="@((bool on) => SelectAllVisible(on))" />
                <FluentButton Appearance="Appearance.Outline" IconStart="@(new Icons.Regular.Size16.ArrowClockwise())"
                              Disabled="@(SelectedVisible.Count == 0 || Processor.IsRunning)" OnClick="ReanalyzeSelectedAsync">選択したメールを再解析</FluentButton>
                <span class="sub">@(SelectedVisible.Count == 0 ? "チェックしたメールを今の設定で解析し直します（人が確認したメールは結果を変えず、履歴だけ追加）" : $"{SelectedVisible.Count} 件を選択中")</span>
                @if (SelectedVisible.Count > 0)
                {
                    <FluentButton Appearance="Appearance.Stealth" OnClick="@(() => _selected.Clear())">選択を解除</FluentButton>
                }
            }
        </div>
        <FluentDataGrid Items="@Visible" TGridItem="MailRow" ShowHover="true" Class="clickable-grid"
                        GridTemplateColumns="40px 104px 146px minmax(90px, 1fr) minmax(140px, 2fr) 70px 48px"
                        OnRowClick="@((FluentDataGridRow<MailRow> row) => Open(row.Item))">
            <TemplateColumn>
                <ChildContent>
                    <div @onclick:stopPropagation="true">
                        <FluentCheckbox Value="@_selected.Contains(context.Id)" ValueChanged="@((bool on) => Select(context.Id, on))" />
                    </div>
                </ChildContent>
            </TemplateColumn>
            <TemplateColumn Title="状態">
                <span class="@StatusDisplay.CssClass(context.Status)">@StatusDisplay.Label(context.Status)</span>
            </TemplateColumn>
            <PropertyColumn Title="受信日時" Property="@(m => m.ReceivedAt)" Format="yyyy/MM/dd HH:mm" Sortable="true" IsDefaultSortColumn="true" InitialSortDirection="SortDirection.Descending" />
            <PropertyColumn Title="差出人" Property="@(m => m.From)" Sortable="true" />
            <PropertyColumn Title="件名" Property="@(m => m.Subject)" />
            <PropertyColumn Title="自信度" Property="@(m => m.Confidence)" Format="P0" Sortable="true" />
            <TemplateColumn Title="確認">
                @if (context.IsReviewed)
                {
                    <FluentIcon Value="@(new Icons.Regular.Size16.PersonAvailable())" Title="人が確認済み" />
                }
            </TemplateColumn>
        </FluentDataGrid>
    }
</div>

@code {
    private static readonly (string Key, string Label)[] Filters =
    [
        ("all", "すべて"),
        (nameof(MailStatus.NeedsReview), "要確認"),
        (nameof(MailStatus.Registered), "発注"),
        (nameof(MailStatus.NotOrder), "発注以外"),
        (nameof(MailStatus.Failed), "解析失敗"),
    ];

    private List<MailRow> _rows = [];
    private string _filter = "all";
    private string? _query;
    private HashSet<int>? _matches;

    private IEnumerable<MailRow> Searched => _matches is null ? _rows : _rows.Where(r => _matches.Contains(r.Id));

    private IQueryable<MailRow> Visible =>
        (_filter == "all" ? Searched : Searched.Where(r => r.Status.ToString() == _filter)).AsQueryable();

    private readonly HashSet<int> _selected = [];
    private CancellationTokenSource? _reanalyzeCts;

    private List<int> SelectedVisible => Visible.Where(r => _selected.Contains(r.Id)).Select(r => r.Id).ToList();

    private bool AllVisibleSelected => Visible.Any() && Visible.All(r => _selected.Contains(r.Id));

    private void Select(int id, bool on)
    {
        if (on) _selected.Add(id);
        else _selected.Remove(id);
    }

    private void SelectAllVisible(bool on)
    {
        foreach (var row in Visible) Select(row.Id, on);
    }

    private async Task ReanalyzeSelectedAsync()
    {
        var ids = SelectedVisible;
        _reanalyzeCts = new CancellationTokenSource();
        try
        {
            var (analyzed, failed) = await Processor.ReanalyzeAsync(ids, _reanalyzeCts.Token);
            var stopped = analyzed + failed < ids.Count ? $"（中止：{ids.Count - analyzed - failed} 件は未実行）" : "";
            if (failed > 0) Toast.ShowWarning($"再解析 {analyzed} 件、失敗 {failed} 件{stopped}");
            else Toast.ShowSuccess($"{analyzed} 件を再解析しました{stopped}。");
            _selected.Clear();
        }
        finally
        {
            _reanalyzeCts.Dispose();
            _reanalyzeCts = null;
        }
    }

    private void CancelReanalyze() => _reanalyzeCts?.Cancel();

    private int Count(string key) => key == "all" ? Searched.Count() : Searched.Count(r => r.Status.ToString() == key);

    protected override async Task OnInitializedAsync()
    {
        Processor.StateChanged += OnChanged;
        Review.Changed += OnChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var mails = await db.Mails
            .Select(m => new { m.Id, m.Status, m.ReceivedAt, m.FromName, m.FromAddress, m.Subject, m.Confidence, m.ReviewedAt })
            .ToListAsync();
        _rows = mails
            .Select(m => new MailRow(
                m.Id,
                m.Status,
                DateTime.SpecifyKind(m.ReceivedAt, DateTimeKind.Utc).ToLocalTime(),
                string.IsNullOrEmpty(m.FromName) ? m.FromAddress : m.FromName,
                m.Subject,
                m.Confidence,
                m.ReviewedAt is not null))
            .ToList();
        _matches = await MailSearch.FindAsync(db, _query);
    }

    private async Task SearchAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _matches = await MailSearch.FindAsync(db, _query);
    }

    private async Task RunAsync()
    {
        var result = await Processor.RunAsync();
        if (result.Error is { } error) Toast.ShowError("取り込みに失敗しました: " + error);
        else Toast.ShowSuccess($"取り込み {result.Imported} 件、解析 {result.Analyzed} 件" + (result.Failed > 0 ? $"（失敗 {result.Failed} 件）" : ""));
    }

    private void Open(MailRow? row)
    {
        if (row is not null) Nav.NavigateTo($"mails/{row.Id}");
    }

    private void OnChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        Processor.StateChanged -= OnChanged;
        Review.Changed -= OnChanged;
    }

    private sealed record MailRow(int Id, MailStatus Status, DateTime ReceivedAt, string From, string Subject, double? Confidence, bool IsReviewed);
}
