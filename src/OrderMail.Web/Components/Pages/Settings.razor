@page "/settings"
@using System.Diagnostics
@using OrderMail.Core.Mail
@inject SettingsStore Store
@inject AnalyzerFactory Analyzers
@inject MailSourceFactory Sources
@inject PromptEvaluator Evaluator
@inject ReviewService Review
@inject MailProcessor Processor
@inject ProductCatalogService Catalog
@inject IDialogService Dialogs
@inject IToastService Toast
@implements IDisposable

<PageTitle>設定</PageTitle>

<div class="page-head">
    <h2>設定</h2>
    <span class="spacer"></span>
    <FluentButton Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size20.Save())" OnClick="Save">保存</FluentButton>
</div>

<div class="settings">
    <section class="panel">
        <h3>メールの取得元</h3>
        <FluentRadioGroup TValue="MailSourceKind" @bind-Value="_s.Mail.Kind" Orientation="Orientation.Horizontal">
            <FluentRadio Value="MailSourceKind.EmlFolder">.eml フォルダ</FluentRadio>
            <FluentRadio Value="MailSourceKind.Imap">IMAP（メールサーバー）</FluentRadio>
        </FluentRadioGroup>

        @if (_s.Mail.Kind == MailSourceKind.EmlFolder)
        {
            <div class="row">
                <div class="field wide">
                    <FluentTextField Label="フォルダ（相対パスはアプリの場所から）" @bind-Value="_s.Mail.EmlFolder" />
                    <div class="sub">@Sources.ResolveFolder(_s.Mail.EmlFolder)</div>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                <div class="field"><FluentTextField Label="サーバー" Placeholder="imap.example.com" @bind-Value="_s.Mail.ImapHost" /></div>
                <div class="field"><FluentNumberField TValue="int" Label="ポート" @bind-Value="_s.Mail.ImapPort" Min="1" Max="65535" /></div>
                <div class="field"><FluentTextField Label="ユーザー名" @bind-Value="_s.Mail.ImapUser" /></div>
                <div class="field"><FluentTextField Label="パスワード" TextFieldType="TextFieldType.Password" @bind-Value="_s.Mail.ImapPassword" /></div>
                <div class="field"><FluentTextField Label="フォルダ" @bind-Value="_s.Mail.ImapFolder" /></div>
                <div class="field"><FluentNumberField TValue="int" Label="取り込む期間（日）" @bind-Value="_s.Mail.ImapSinceDays" Min="1" /></div>
                <div class="field"><FluentCheckbox Label="SSL/TLS で接続する" @bind-Value="_s.Mail.ImapUseSsl" /></div>
            </div>
            <FluentButton Appearance="Appearance.Outline" IconStart="@(new Icons.Regular.Size16.PlugConnected())" Disabled="_testing" OnClick="TestImapAsync">接続テスト</FluentButton>
        }

        <div class="row" style="margin-top: 12px">
            <div class="field" style="align-self: end"><FluentSwitch Label="自動で取り込む" @bind-Value="_s.Mail.AutoPoll" /></div>
            <div class="field"><FluentNumberField TValue="int" Label="間隔（分）" @bind-Value="_s.Mail.PollIntervalMinutes" Min="1" Disabled="!_s.Mail.AutoPoll" /></div>
        </div>
    </section>

    <section class="panel">
        <h3>AI の接続先</h3>
        <FluentRadioGroup TValue="AiProvider" @bind-Value="_s.Ai.Provider" Orientation="Orientation.Horizontal">
            <FluentRadio Value="AiProvider.RuleBased">使わない（ルールベース）</FluentRadio>
            <FluentRadio Value="AiProvider.OpenAiCompatible">OpenAI 互換 API</FluentRadio>
        </FluentRadioGroup>

        @if (_s.Ai.Provider == AiProvider.OpenAiCompatible)
        {
            <p class="sub">Azure OpenAI・OpenAI・Gemini・Ollama・LM Studio など、OpenAI 互換の API に接続できます。プリセットで入力欄を埋めてから調整してください。</p>
            <div class="presets">
                @foreach (var p in Presets)
                {
                    <FluentButton Appearance="Appearance.Outline" OnClick="@(() => ApplyPreset(p))">@p.Name</FluentButton>
                }
            </div>
            @if (_presetHint is not null)
            {
                <p class="sub preset-hint">@_presetHint</p>
            }
            <div class="row">
                <div class="field wide"><FluentTextField Label="エンドポイント" @bind-Value="_s.Ai.Endpoint" /></div>
                <div class="field"><FluentTextField Label="モデル" @bind-Value="_s.Ai.Model" /></div>
                <div class="field"><FluentTextField Label="API キー（ローカル LLM なら空欄）" TextFieldType="TextFieldType.Password" @bind-Value="_s.Ai.ApiKey" /></div>
                <div class="field"><FluentNumberField TValue="int" Label="タイムアウト（秒）" @bind-Value="_s.Ai.TimeoutSeconds" Min="5" /></div>
                <div class="field" style="align-self: end"><FluentCheckbox Label="JSON スキーマ指定を使う（非対応なら自動で切り替え）" @bind-Value="_s.Ai.UseJsonSchema" /></div>
            </div>
        }
        else
        {
            <p class="sub">キーワードと書式のパターンで判定します。AI を用意しなくても動作確認できますが、自由な文面には弱いです。</p>
        }

        <FluentButton Appearance="Appearance.Outline" IconStart="@(new Icons.Regular.Size16.PlugConnected())" Disabled="_testing" OnClick="TestAiAsync">テスト解析</FluentButton>
        @if (_testing)
        {
            <FluentProgressRing Width="16px" Style="display: inline-block; margin-left: 8px" />
        }
        @if (_aiTestResult is not null)
        {
            <div class="test-result">@_aiTestResult</div>
        }
    </section>

    @if (_s.Ai.Provider == AiProvider.OpenAiCompatible)
    {
        <section class="panel">
            <h3>AI への指示（プロンプト）</h3>
            <p class="sub">判定と抽出のルールを書き換えられます。出力形式（JSON のキー）と、当社名・受信日のカレンダーはアプリが自動で付け足します。変更したら下の「確認済みメールで評価」で効果を確かめてから保存してください。</p>
            <div class="row">
                <div class="field"><FluentTextField Label="当社名（宛名を発注元と取り違えないように AI に伝えます）" Placeholder="例: サンプル商事" @bind-Value="_s.Ai.OwnCompanyName" /></div>
                <div class="field"><FluentNumberField TValue="int" Label="手本にする確認済みメールの数（0 で使わない）" @bind-Value="_s.Ai.ExampleCount" Min="0" Max="10" /></div>
            </div>
            <div class="field">
                <FluentTextArea Label="判定・抽出のルール" Rows="22" Resize="TextAreaResize.Vertical" Class="prompt-editor" @bind-Value="_instructions" />
            </div>
            <div class="actions">
                <FluentButton Appearance="Appearance.Outline" Disabled="IsDefaultInstructions" OnClick="ResetInstructions">既定に戻す</FluentButton>
                <FluentButton Appearance="Appearance.Outline" OnClick="TogglePreview">@(_preview is null ? "送信内容を表示" : "送信内容を隠す")</FluentButton>
                <span class="sub" style="align-self: center">@(IsDefaultInstructions ? "既定のルールを使用中" : "編集済み（保存すると反映）")</span>
            </div>
            @if (_preview is not null)
            {
                <div class="test-result prompt-preview">@_preview</div>
            }
            <p class="sub">手本：担当者が確定したメールのうち、差出人が同じものや文面が似ているものを、正しい答えと一緒に AI に見せます。確定するほど、取引先ごとの書き方に合った読み取りになります。</p>
        </section>
    }

    <section class="panel">
        <h3>商品マスタ（RAG）</h3>
        <p class="sub">メールの品名を自社の商品マスタと照合し、明細に商品コードを付けます。AI を使うときは、本文から検索した候補をメールと一緒に渡し、その中から選ばせます（RAG）。AI の答えのコードはマスタで確かめ、メールに単価がなければマスタの単価を入れます。AI を使わないときも、品名が 1 つの商品に決まれば照合します。</p>
        <div class="row">
            <div class="field" style="align-self: end"><FluentSwitch Label="商品マスタを使う" @bind-Value="_s.Catalog.Enabled" /></div>
            <div class="field wide">
                <FluentTextField Label="CSV ファイル（列: code, name, aliases, unit, unit_price。相対パスはアプリの場所から）" @bind-Value="_s.Catalog.CsvPath" />
                <div class="sub">@Catalog.ResolvePath(_s.Catalog.CsvPath)</div>
            </div>
        </div>
        <div class="actions" style="margin-top: 0">
            <FluentButton Appearance="Appearance.Outline" IconStart="@(new Icons.Regular.Size16.ArrowImport())" Disabled="_catalogBusy" OnClick="ImportCatalogAsync">CSV を取り込む（置き換え）</FluentButton>
            <span class="sub" style="align-self: center">@CatalogStatus</span>
        </div>

        @if (_s.Ai.Provider == AiProvider.OpenAiCompatible)
        {
            <div class="row">
                <div class="field"><FluentNumberField TValue="int" Label="AI に渡す候補の数" @bind-Value="_s.Catalog.CandidateCount" Min="1" Max="20" /></div>
                <div class="field"><FluentTextField Label="埋め込みモデル（空欄ならキーワード検索のみ）" Placeholder="例: text-embedding-3-small" @bind-Value="_s.Ai.EmbeddingModel" /></div>
            </div>
            <p class="sub">埋め込みモデルを設定すると、言葉が一致しない書き方（「無線マウス」と「ワイヤレスマウス」など）も意味の近さで探します。チャットと同じ接続先・API キーを使います（Azure OpenAI ではデプロイ名、Ollama では bge-m3 など）。モデルを変えたらベクトルを作り直してください。</p>
            <div class="actions" style="margin-top: 0">
                <FluentButton Appearance="Appearance.Outline" IconStart="@(new Icons.Regular.Size16.DataUsage())"
                              Disabled="@(_catalogBusy || string.IsNullOrWhiteSpace(_s.Ai.EmbeddingModel))" OnClick="BuildVectorsAsync">ベクトルを作成</FluentButton>
                @if (_catalogBusy)
                {
                    <FluentProgressRing Width="16px" Style="align-self: center" />
                    <span class="sub" style="align-self: center">@_catalogProgress</span>
                }
            </div>
        }

        <div class="row">
            <div class="field wide"><FluentTextField Label="試しに検索（メールの一文など）" Placeholder="例: 無線マウス 黒を25個" Immediate="true" @bind-Value="_searchText" /></div>
            <div class="field" style="align-self: end">
                <FluentButton Appearance="Appearance.Outline" IconStart="@(new Icons.Regular.Size16.Search())" Disabled="@(_catalogBusy || string.IsNullOrWhiteSpace(_searchText))" OnClick="SearchCatalogAsync">検索</FluentButton>
            </div>
        </div>
        @if (_hits is not null)
        {
            if (_hits.Count == 0)
            {
                <p class="sub">候補は見つかりませんでした。</p>
            }
            else
            {
                <table class="eval-table">
                    <tr><th>コード</th><th>商品名</th><th>単価</th><th>キーワード</th><th>意味（ベクトル）</th></tr>
                    @foreach (var h in _hits)
                    {
                        <tr>
                            <td>@h.Product.Code</td>
                            <td>@h.Product.Name</td>
                            <td>@(h.Product.UnitPrice?.ToString("#,0.##") ?? "－")</td>
                            <td>@h.Keyword.ToString("0.00")</td>
                            <td>@(h.Vector?.ToString("0.00") ?? "－")</td>
                        </tr>
                    }
                </table>
            }
        }
    </section>

    <section class="panel">
        <h3>評価</h3>
        <p class="sub">担当者が確定したメール（新しい順に @MaxEvalMails 件まで）を、この画面の設定（保存前でも可）で解析し直して、確定した内容と比べます。結果は保存されず、メールの状態も変わりません。手本は評価するメール自身を除いて選びます。</p>
        <div class="actions" style="margin-top: 0">
            <FluentButton Appearance="Appearance.Outline" IconStart="@(new Icons.Regular.Size16.DataBarVertical())" Disabled="@(_evaluating || _testing)" OnClick="EvaluateAsync">確認済みメールで評価</FluentButton>
            @if (_evaluating)
            {
                <FluentProgressRing Width="16px" Style="align-self: center" />
                <span class="sub" style="align-self: center">@_evalProgress</span>
                <FluentButton Appearance="Appearance.Stealth" OnClick="CancelEvaluation">中止</FluentButton>
            }
        </div>

        @if (_report is { } r)
        {
            <div class="sub" style="margin-top: 10px">@r.Analyzer@(r.ExampleCount > 0 ? $"・手本 {r.ExampleCount} 件まで" : "")・@r.Total 件（うち発注 @r.Orders 件）</div>
            <table class="eval-table">
                <tr><th></th><th>今回</th>@if (_previousReport is not null) {<th>前回</th>}</tr>
                @foreach (var (label, value) in EvaluationText.Metrics)
                {
                    <tr>
                        <td>@label</td>
                        <td>@value(r)</td>
                        @if (_previousReport is { } p)
                        {
                            <td class="sub">@value(p)</td>
                        }
                    </tr>
                }
            </table>

            var misses = r.Rows.Where(x => !x.AllOk).ToList();
            if (misses.Count == 0)
            {
                <p class="sub">すべて確定内容と一致しました。</p>
            }
            else
            {
                <strong style="font-size: 13px">確定内容と違ったメール（@misses.Count 件）</strong>
                <ul class="eval-misses">
                    @foreach (var row in misses)
                    {
                        <li>
                            <a href="@($"mails/{row.MailId}")" target="_blank">@row.Subject</a>
                            @foreach (var diff in EvaluationText.Differences(row))
                            {
                                <div class="sub">@diff</div>
                            }
                        </li>
                    }
                </ul>
            }
        }
    </section>

    <section class="panel">
        <h3>自動登録</h3>
        <p class="sub">AI の自信度がこの値以上なら、人の確認なしで「発注」または「発注以外」に振り分けます。下回るものは「要確認」になります。</p>
        <div class="row">
            <div class="field"><FluentNumberField TValue="double" Label="自信度のしきい値（0〜1）" @bind-Value="_s.AutoRegisterThreshold" Min="0" Max="1" Step="0.05" /></div>
        </div>
    </section>

    <section class="panel debug-panel">
        <h3>デバッグ</h3>
        <p class="sub">人の確認（「発注として登録」「発注ではない」）をすべて取り消し、確認前の状態に戻します。人が確定した発注は削除され、対象のメールは「未解析」に戻ります。「受信メール」で「取り込み・解析」を押すと、今の設定で解析し直します。人が確認していない自動登録の発注と、解析履歴は残ります。</p>
        <div class="actions" style="margin-top: 0">
            <FluentButton Appearance="Appearance.Outline" IconStart="@(new Icons.Regular.Size16.ArrowUndo())"
                          Disabled="@(_reviewedCount == 0 || _evaluating || Processor.IsRunning)" OnClick="ClearReviewsAsync">人の確認をすべて取り消す</FluentButton>
            <span class="sub" style="align-self: center">確認済み：@(_reviewedCount?.ToString() ?? "…") 件</span>
        </div>
    </section>

    <p class="sub">API キーと IMAP パスワードは Windows のユーザーごとに暗号化して保存します。</p>
</div>

@code {
    private sealed record Preset(string Name, string Endpoint, string Model, string? Hint = null);

    private static readonly Preset[] Presets =
    [
        new("Azure OpenAI", "https://YOUR-RESOURCE.openai.azure.com/openai/v1", "gpt-4.1-mini",
            "エンドポイントの YOUR-RESOURCE を Azure OpenAI のリソース名に、モデルをデプロイ名に置き換えてください。API キーは Azure ポータルの「キーとエンドポイント」にあります（api-key ヘッダーで送ります）。"),
        new("OpenAI", "https://api.openai.com/v1", "gpt-4.1-mini"),
        new("Gemini", "https://generativelanguage.googleapis.com/v1beta/openai", "gemini-2.5-flash"),
        new("Ollama", "http://localhost:11434/v1", "qwen2.5:7b", "API キーは空欄のままで使えます。事前に ollama pull でモデルを取得してください。"),
        new("LM Studio", "http://localhost:1234/v1", "", "LM Studio で読み込んだモデル名を入力してください。API キーは空欄で使えます。"),
    ];

    private string? _presetHint;

    private static readonly MailInput TestMail = new(
        "発注のお願い",
        "test@example.com",
        "テスト 太郎",
        "いつもお世話になっております。テスト商事の田中です。\n下記の通り発注いたします。\n・A4コピー用紙 × 10箱\n・ボールペン（黒）50本\n納期は来週金曜日までにお願いします。",
        DateTime.UtcNow);

    private const int MaxEvalMails = 50;

    private AppSettings _s = new();
    private bool _testing;
    private string? _aiTestResult;
    private string _instructions = "";
    private string? _preview;
    private bool _evaluating;
    private string? _evalProgress;
    private EvaluationReport? _report;
    private EvaluationReport? _previousReport;
    private CancellationTokenSource? _evalCts;

    private int? _reviewedCount;

    private bool _catalogBusy;
    private string? _catalogProgress;
    private CatalogStats? _catalogStats;
    private string? _searchText;
    private IReadOnlyList<ProductHit>? _hits;

    protected override async Task OnInitializedAsync()
    {
        _s = Store.Current;
        _instructions = OrderPrompt.Instructions(_s.Ai);
        _reviewedCount = await Review.CountReviewedAsync();
        await RefreshCatalogStatsAsync();
    }

    private string CatalogStatus => _catalogStats is not { } s ? "…"
        : s.Count == 0 ? "商品マスタは空です。"
        : string.IsNullOrWhiteSpace(_s.Ai.EmbeddingModel) || _s.Ai.Provider != AiProvider.OpenAiCompatible ? $"登録 {s.Count} 件"
        : $"登録 {s.Count} 件・ベクトル作成済み {s.Embedded} 件（{_s.Ai.EmbeddingModel.Trim()}）";

    private async Task RefreshCatalogStatsAsync() => _catalogStats = await Catalog.StatsAsync(_s.Ai.EmbeddingModel);

    private async Task ImportCatalogAsync()
    {
        _catalogBusy = true;
        try
        {
            var result = await Catalog.ImportCsvAsync(_s.Catalog.CsvPath);
            if (result.Count == 0)
            {
                Toast.ShowError("取り込めませんでした: " + string.Join(" ", result.Warnings));
                return;
            }
            var kept = result.KeptVectors > 0 ? $"（作成済みのベクトル {result.KeptVectors} 件はそのまま）" : "";
            Toast.ShowSuccess($"{result.Count} 件を取り込みました{kept}。" + (result.Warnings.Count > 0 ? " " + string.Join(" ", result.Warnings.Take(3)) : ""));
            _hits = null;
        }
        finally
        {
            _catalogBusy = false;
            await RefreshCatalogStatsAsync();
        }
    }

    private async Task BuildVectorsAsync()
    {
        _catalogBusy = true;
        var progress = new Progress<string>(p =>
        {
            _catalogProgress = p;
            StateHasChanged();
        });
        try
        {
            var count = await Catalog.BuildEmbeddingsAsync(_s.Copy().Ai, progress);
            Toast.ShowSuccess(count == 0 ? "すべての商品のベクトルを作成済みです。" : $"{count} 件のベクトルを作成しました。設定を保存すると解析で使います。");
        }
        catch (Exception e)
        {
            Toast.ShowError("ベクトルを作成できませんでした: " + e.Message);
        }
        finally
        {
            _catalogBusy = false;
            _catalogProgress = null;
            await RefreshCatalogStatsAsync();
        }
    }

    private async Task SearchCatalogAsync()
    {
        _catalogBusy = true;
        try
        {
            var settings = _s.Copy();
            settings.Catalog.Enabled = true;
            _hits = await Catalog.SearchAsync(_searchText ?? "", settings);
        }
        finally
        {
            _catalogBusy = false;
        }
    }

    private async Task ClearReviewsAsync()
    {
        var dialog = await Dialogs.ShowConfirmationAsync(
            $"人が確認した {_reviewedCount} 件のメールを確認前に戻し、人が確定した発注を削除します。元に戻せません。よろしいですか？",
            "取り消す", "キャンセル", "人の確認をすべて取り消す");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        var count = await Review.ClearAllReviewsAsync();
        _reviewedCount = await Review.CountReviewedAsync();
        _report = null;
        _previousReport = null;
        Toast.ShowSuccess($"{count} 件の確認を取り消しました。「受信メール」で「取り込み・解析」を押すと解析し直します。");
    }

    public void Dispose() => _evalCts?.Cancel();

    private bool IsDefaultInstructions =>
        string.IsNullOrWhiteSpace(_instructions) || Plain(_instructions) == Plain(OrderPrompt.DefaultInstructions);

    private static string Plain(string s) => s.Replace("\r\n", "\n").Trim();

    /// <summary>Unchanged rules are stored as null so that improvements to the default reach this installation.</summary>
    private void ApplyInstructions()
    {
        _s.Ai.Instructions = IsDefaultInstructions ? null : Plain(_instructions);
        _s.Ai.ExampleCount = Math.Clamp(_s.Ai.ExampleCount, 0, 10);
    }

    private void ResetInstructions()
    {
        _instructions = OrderPrompt.DefaultInstructions;
        if (_preview is not null) TogglePreview();
    }

    private void TogglePreview()
    {
        if (_preview is not null)
        {
            _preview = null;
            return;
        }
        ApplyInstructions();
        _preview = OrderPrompt.System(_s.Ai, TestMail.ReceivedAtUtc.ToLocalTime(), _s.Ai.ExampleCount > 0)
            + "\n\n────────\n（ここに手本のメールと正しい出力が続き、最後に解析するメールと商品マスタの候補が入ります。例：）\n\n"
            + OrderPrompt.User(TestMail, products: [new CatalogProduct("CP-A4-2500", "A4コピー用紙 500枚×5冊入", "箱", 2980)]);
    }

    private async Task EvaluateAsync()
    {
        ApplyInstructions();
        _evaluating = true;
        _evalCts = new CancellationTokenSource();
        var progress = new Progress<string>(p =>
        {
            _evalProgress = p;
            StateHasChanged();
        });
        try
        {
            var report = await Evaluator.EvaluateAsync(_s.Copy(), MaxEvalMails, progress, _evalCts.Token);
            if (report.Total == 0)
            {
                Toast.ShowInfo("確認済みのメールがありません。メール詳細で「発注として登録」か「発注ではない」を押すと、評価と手本に使えるようになります。");
                return;
            }
            _previousReport = _report;
            _report = report;
        }
        catch (OperationCanceledException)
        {
            Toast.ShowInfo("評価を中止しました。");
        }
        finally
        {
            _evaluating = false;
            _evalProgress = null;
            _evalCts?.Dispose();
            _evalCts = null;
        }
    }

    private void CancelEvaluation() => _evalCts?.Cancel();

    private void ApplyPreset(Preset p)
    {
        _s.Ai.Endpoint = p.Endpoint;
        _s.Ai.Model = p.Model;
        _presetHint = p.Hint;
    }

    private void Save()
    {
        ApplyInstructions();
        _s.AutoRegisterThreshold = Math.Clamp(_s.AutoRegisterThreshold, 0, 1);
        _s.Catalog.CandidateCount = Math.Clamp(_s.Catalog.CandidateCount, 1, 20);
        Store.Save(_s);
        Toast.ShowSuccess("設定を保存しました。");
    }

    private async Task TestAiAsync()
    {
        _testing = true;
        _aiTestResult = null;
        ApplyInstructions();
        var settings = _s.Copy();
        var analyzer = Analyzers.Create(settings.Ai);
        var watch = Stopwatch.StartNew();
        try
        {
            var products = settings.Ai.Provider == AiProvider.OpenAiCompatible ? await Catalog.CandidatesAsync(TestMail, settings) : [];
            var result = await analyzer.AnalyzeAsync(TestMail, new AnalysisContext([], products), CancellationToken.None);
            var candidates = products.Count > 0 ? $"・商品マスタの候補 {products.Count} 件" : "";
            _aiTestResult = $"成功：{analyzer.Name}{candidates}（{watch.ElapsedMilliseconds} ms）\n\n{ExtractionJson.Serialize(result)}";
        }
        catch (Exception e)
        {
            _aiTestResult = $"失敗：{e.Message}";
        }
        finally
        {
            _testing = false;
        }
    }

    private async Task TestImapAsync()
    {
        _testing = true;
        try
        {
            var count = await new ImapMailSource(_s.Mail).TestAsync(CancellationToken.None);
            Toast.ShowSuccess($"接続できました（{_s.Mail.ImapFolder}：{count} 件）。");
        }
        catch (Exception e)
        {
            Toast.ShowError("接続できませんでした: " + e.Message);
        }
        finally
        {
            _testing = false;
        }
    }
}
