@inherits LayoutComponentBase

<div class="shell">
    <header class="app-header">
        <FluentIcon Value="@(new Icons.Regular.Size24.MailInbox())" Color="Color.Custom" CustomColor="#ffffff" />
        <span class="app-title">発注メール AI 仕分け</span>
    </header>
    <nav class="app-nav">
        <FluentNavMenu Width="200" Collapsible="false">
            <FluentNavLink Href="mails" Match="NavLinkMatch.Prefix" Icon="@(new Icons.Regular.Size20.Mail())">受信メール</FluentNavLink>
            <FluentNavLink Href="orders" Match="NavLinkMatch.Prefix" Icon="@(new Icons.Regular.Size20.ClipboardTaskListLtr())">発注一覧</FluentNavLink>
            <FluentNavLink Href="improve" Match="NavLinkMatch.Prefix" Icon="@(new Icons.Regular.Size20.ArrowTrending())">AI の改善</FluentNavLink>
            <FluentNavLink Href="settings" Match="NavLinkMatch.Prefix" Icon="@(new Icons.Regular.Size20.Settings())">設定</FluentNavLink>
        </FluentNavMenu>
    </nav>
    <main class="app-body">
        @Body
    </main>
</div>

<FluentToastProvider />
<FluentDialogProvider />
<FluentTooltipProvider />
<DemoNotice />

<div id="blazor-error-ui" data-nosnippet>
    エラーが発生しました。
    <a href="." class="reload">再読み込み</a>
    <span class="dismiss">×</span>
</div>
